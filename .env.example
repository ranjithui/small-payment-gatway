# Copy to .env (or export) - values below are LOCAL DEVELOPMENT defaults.
# Production needs only: FEEFLOW_ENV=production, DATABASE_URL, FEEFLOW_SECRET_KEY,
# FEEFLOW_ADMIN_EMAIL, FEEFLOW_ADMIN_PASSWORD (workspace + UPI ID are set up in the app).
FEEFLOW_DATABASE_URL=sqlite:///./feeflow.db
# Supabase: postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
FEEFLOW_SECRET_KEY=change-me-to-a-long-random-string
FEEFLOW_PUBLIC_BASE_URL=http://localhost:8000
FEEFLOW_ADMIN_TOKEN_TTL=28800
FEEFLOW_RATE_LIMIT=1
FEEFLOW_BACKGROUND_JOBS=1
FEEFLOW_JOB_INTERVAL=60

# Seeded demo logins (python -m app.seed) - local development only:
#   admin@brightminds.test / feeflow-demo-123
#   admin@sunrise.test     / feeflow-demo-456
#   founder@newcentre.test / feeflow-demo-789   (no workspace yet - try first-time setup)
#   device token: demo-device-token-brightminds-0001
